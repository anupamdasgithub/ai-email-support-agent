# ===========================================================================
# .env — environment variables for the Spring Boot worker application
# Copy this to your project root and fill in your values.
# DO NOT commit this file to version control.
# ===========================================================================

# ── Keycloak OAuth2 token endpoint ─────────────────────────────────────────
# Default Docker Compose Keycloak runs on port 18080
KEYCLOAK_TOKEN_URL=http://localhost:18080/auth/realms/camunda-platform/protocol/openid-connect/token

# ── Zeebe worker client credentials ────────────────────────────────────────
# These are created in Camunda Identity (see Step 3 of the setup guide)
ZEEBE_CLIENT_ID=bank-loan-worker
ZEEBE_CLIENT_SECRET=REPLACE_ME

# ── Zeebe endpoints ─────────────────────────────────────────────────────────
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500
ZEEBE_REST_ADDRESS=http://localhost:8080

# ── Operate URL ─────────────────────────────────────────────────────────────
OPERATE_URL=http://localhost:8081

# ── Tasklist URL ────────────────────────────────────────────────────────────
TASKLIST_URL=http://localhost:8082

# ── Anthropic — only needed if you add a Java-based Claude call directly ────
# (The Connectors runtime reads this from connector-secrets.txt instead)
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
